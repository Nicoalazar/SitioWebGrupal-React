                        { "nombre": "ComparadorGustos", "archivo": "src/components/interacciones/ComparadorGustos.jsx", "descripcion": "Nicolás Zalazar." },
                        { "nombre": "EncontraBug", "archivo": "src/components/interacciones/EncontraBug.jsx", "descripcion": "Laura Belén Blanco." },
                        { "nombre": "CitasTrivia", "archivo": "src/components/interacciones/CitasTrivia.jsx", "descripcion": "Christian Albornoz." },
                        { "nombre": "TestPresion", "archivo": "src/components/interacciones/TestPresion.jsx", "descripcion": "Laura Olivera." },
                        { "nombre": "RinconMusical", "archivo": "src/components/interacciones/RinconMusical.jsx", "descripcion": "Fernando Guevara." }
                      ]
                    }
